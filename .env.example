# Server
PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/inventory_test"

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=7d
